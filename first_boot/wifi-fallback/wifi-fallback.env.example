# Copy to wifi-fallback.env and adjust. AP_SSID/AP_CONNECTION default to {hostname}-setup.
AP_PASSWORD=raspi-setup
AP_IFACE=wlan0
AP_ADDRESS=10.42.0.1
AP_PREFIX=24

# Seconds between connectivity checks.
CHECK_INTERVAL=15
# Seconds offline before the AP is raised (also used at boot).
OFFLINE_GRACE=45
# Seconds to wait for a user-chosen WiFi to come up.
CONNECT_TIMEOUT=30

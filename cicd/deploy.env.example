# Copy to deploy.env (gitignored). Lives on the Pi; GitHub never reads this file.
# Register the runner on YOUR fork, never on upstream.

# Where the repo is kept on this Pi.
DEPLOY_DIR=$HOME/spaguetti-nomad-pi

# Your fork. Empty = git remote origin.
# REPO_URL=https://github.com/you/spaguetti-nomad-pi

# Must match runs-on in .github/workflows/deploy.yml
RUNNER_LABEL=raspi
# RUNNER_NAME=
# RUNNER_DIR=$HOME/actions-runner
